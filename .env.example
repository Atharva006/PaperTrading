# ====================================================================
# TradeEdge - Indian Stock Market Paper Trading Platform Environment
# ====================================================================

# 1. Supabase Backend Configuration
# Obtain from: https://supabase.com/dashboard/project/<your-project-id>/settings/api
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# 2. Upstox Developer API v2 Credentials
# Obtain from: https://developer.upstox.com/ -> Create App
# Required Permissions: Market Data Feed, Quotes, Option Chain, Interactive Orders (Read-only for market data)
VITE_UPSTOX_API_KEY=your_upstox_api_key_here
VITE_UPSTOX_API_SECRET=your_upstox_api_secret_here
VITE_UPSTOX_REDIRECT_URI=http://localhost:5173/dashboard/settings
VITE_UPSTOX_ACCESS_TOKEN=optional_static_or_cached_access_token

# 3. Application Defaults
VITE_DEFAULT_VIRTUAL_BALANCE=1000000
VITE_DEFAULT_SLIPPAGE_BPS=5
VITE_DEMO_MODE=true
